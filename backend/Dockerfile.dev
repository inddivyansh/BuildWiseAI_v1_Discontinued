# BuildWise AI — Backend Dockerfile (Development)
# Includes dev tools and enables hot-reload via volume mount

FROM python:3.11-slim-bookworm

# System dependencies (same as production)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    tesseract-ocr \
    tesseract-ocr-eng \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies (both prod and dev)
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

# Note: source code is mounted via volume in docker-compose.dev.yml
# No COPY needed — the volume mount takes precedence

EXPOSE 8000

# Dev server: single worker, reload on code changes
CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--reload", \
     "--reload-dir", "/app/app", \
     "--reload-dir", "/app/engines", \
     "--log-level", "debug"]
