# ============================================================
# BuildWise AI — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git.
# ============================================================

# ─── Application ─────────────────────────────────────────
APP_ENV=development
# Options: development | production
DEBUG=true
APP_VERSION=0.1.0

# ─── Database ─────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=buildwise
POSTGRES_USER=buildwise_user
POSTGRES_PASSWORD=changeme_in_production
DATABASE_URL=postgresql+asyncpg://buildwise_user:changeme_in_production@postgres:5432/buildwise

# ─── File Storage ─────────────────────────────────────────
STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=50

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost,http://127.0.0.1

# ─── Gemini LLM Provider ──────────────────────────────────
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model pool — round-robin selection across these 3 models
# Change these if you want different models; no code change needed
GEMINI_MODEL_1=gemini-3.8-flash
GEMINI_MODEL_2=gemini-3.6-flash
GEMINI_MODEL_3=gemini-3.5-flash-lite

# Optional: separate API keys for different Google projects
# Leave blank to use GEMINI_API_KEY for all models
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# LLM request settings
GEMINI_MAX_RETRIES=3
GEMINI_REQUEST_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=2048

# ─── Embeddings ───────────────────────────────────────────
# Embedding model for RAG corpus
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024

# ─── Frontend (Vite build-time variables) ─────────────────
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=BuildWise AI
VITE_APP_VERSION=0.1.0

# ─── Authentication (disabled by default in MVP) ──────────
AUTH_ENABLED=false
JWT_SECRET_KEY=change_this_to_a_random_secret_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_MINUTE=10
